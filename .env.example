# Local Playwright E2E tests. Use an existing ORGANIZER account.
# Keep real credentials in .env only; never commit them.
E2E_BASE_URL=http://localhost:5173
E2E_ORGANIZER_USERNAME=
E2E_ORGANIZER_PASSWORD=
E2E_PARTNER_USERNAME=
E2E_PARTNER_PASSWORD=

# VNPay sandbox integration. Keep real values in .env only.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_CHECKOUT_DURATION_SECONDS=900
VNPAY_QUERY_MIN_INTERVAL_SECONDS=300
VNPAY_RECONCILIATION_DELAY_SECONDS=300
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay/return
VNPAY_SPIKE_RETURN_URL=http://localhost:8090/vnpay/return
VNPAY_SPIKE_PORT=8090
VNPAY_RECONCILIATION_INITIAL_DELAY_MS=60000
VNPAY_RECONCILIATION_FIXED_DELAY_MS=60000
