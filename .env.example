MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@bookstreet.local
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLE=false
