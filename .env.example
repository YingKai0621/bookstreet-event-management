POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bookstreet_db
POSTGRES_USER=bookstreet
POSTGRES_PASSWORD=change_me

REDIS_HOST=localhost
REDIS_PORT=6379

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@bookstreet.local
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLE=false
FRONTEND_BASE_URL=http://localhost:5173

SERVER_PORT=8080

CORS_ALLOWED_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax

# Required for anonymous Feedback throttle keys. Generate a long random deployment secret.
# Keep the real value in .env only; never commit it.
FEEDBACK_THROTTLE_HMAC_SECRET=

# Local Playwright E2E tests. Use an existing ORGANIZER account.
# Keep real credentials in .env only; never commit them.
E2E_ORGANIZER_USERNAME=change_me
E2E_ORGANIZER_PASSWORD=change_me
E2E_PARTNER_USERNAME=change_me
E2E_PARTNER_PASSWORD=change_me

# Gemini chatbot. Keep the real API key in .env only.
GEMINI_API_KEY=
CHATBOT_MODEL=gemini-3.5-flash-lite

# VNPay sandbox integration. Keep real values in .env only.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_CHECKOUT_DURATION_SECONDS=900
VNPAY_QUERY_MIN_INTERVAL_SECONDS=300
VNPAY_RECONCILIATION_DELAY_SECONDS=300
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay/return
VNPAY_SPIKE_RETURN_URL=http://localhost:8090/vnpay/return
VNPAY_SPIKE_PORT=8090
VNPAY_RECONCILIATION_INITIAL_DELAY_MS=60000
VNPAY_RECONCILIATION_FIXED_DELAY_MS=60000
# Optional local directory for Organizer Event banner uploads (relative to backend working directory).
EVENT_BANNER_UPLOAD_DIR=uploads/event-banners
BOOTH_IMAGE_UPLOAD_DIR=uploads/booth-images
HERITAGE_IMAGE_UPLOAD_DIR=uploads/heritage-images
ACTIVITY_IMAGE_UPLOAD_DIR=uploads/activity-images
BADGE_IMAGE_UPLOAD_DIR=uploads/badge-images

# Media storage. Keep "local" for development; use "cloudinary" on Render.
MEDIA_STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
